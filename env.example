# ============ SERVEUR ============
PORT=8080
DATA_DIR=./data                       # dossier persistant (Render : disque persistant ou DATABASE_URL en Dingana 2)
MENTOR_CORS_ORIGIN=                   # origine autorisée pour le frontend (ex. https://ton-site.com) ; vide = même origine
MENTOR_PUBLIC_READ=0                  # 1 = lecture sans clé (héritage, déconseillé)

# ============ AUTHENTIFICATION (Dingana 1 : clés d'API ; Dingana 2 : comptes + JWT) ============
MENTOR_API_KEY=                       # clé de l'utilisateur propriétaire (longue, aléatoire)
ADMIN_API_KEY=                        # clé administrateur (différente de la précédente)
OWNER_USER_ID=owner
# JWT_SECRET=                         # Dingana 2
# DATABASE_URL=                       # Dingana 2 (PostgreSQL)

# ============ cTRADER OPEN API (OAuth officiel — jamais de mot de passe cTrader) ============
CTRADER_CLIENT_ID=                    # portail Open API Spotware : Applications
CTRADER_CLIENT_SECRET=                # serveur uniquement, jamais dans le frontend
CTRADER_REDIRECT_URI=https://TON-DOMAINE/api/ctrader/callback    # identique à celui enregistré dans l'application
CTRADER_POST_CONNECT_URL=/            # page affichée après l'autorisation
TOKEN_ENCRYPTION_KEY=                 # ≥ 32 caractères aléatoires : chiffre (AES-256-GCM) les tokens stockés
# CTRADER_SINGLE_USER_FALLBACK=1      # à n'utiliser qu'en mono-utilisateur si cTrader ne renvoie pas « state »

# ============ IA / MARCHÉ / NEWS ============
TWELVEDATA_API_KEY=                   # prix de secours or (PAPER uniquement)
NEWS_ADMIN_TOKEN=                     # inchangé (news-routes.js)
WEBHOOK_SECRET=                       # vide = webhook désactivé
ORDERFLOW_PUSH_KEY=                   # clé de la source Order Flow externe (Bookmap/Exocharts/feed) ; vide = Order Flow UNAVAILABLE
ORDERFLOW_MAX_AGE_SEC=30              # au-delà : STALE

# ============ LIMITES GLOBALES (modifiables ensuite par l'admin) ============
GLOBAL_MAX_RISK_PCT=2
GLOBAL_LIVE_ALLOWED=1                 # 0 = tout le monde reste en PAPER

# ============ BOOKMAP / EXOCHARTS (données réelles uniquement ; vide = NOT CONNECTED / DATA UNAVAILABLE) ============
# Mode HTTP : le serveur interroge GET <URL>?symbol=XAUUSD avec "Authorization: Bearer <KEY>" et attend un JSON (voir README).
BOOKMAP_API_URL=
BOOKMAP_API_KEY=
EXOCHARTS_API_URL=
EXOCHARTS_API_KEY=
# Mode PUSH : un exporteur/add-on réel envoie ses mesures sur POST /api/orderflow/push (en-tête x-api-key = ORDERFLOW_PUSH_KEY), champ "source": "bookmap" | "exocharts".
ORDERFLOW_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
ORDERFLOW_POLL_MS=3000
